{
  "name": "string-interpolation-js",
  "version": "1.0.8",
  "description": "Simple module to format string from template",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepublish": "pnpm build",
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "update-packages": "pnpm update -i -r --latest",
    "release": "pnpm build && changeset publish",
    "set-release": "changeset"
  },
  "keywords": [
    "string",
    "interpole",
    "interpolation",
    "string-interpole",
    "string-interpolation"
  ],
  "author": "Alpha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgid123/string-interpolation-js.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@alphacifer/biome": "^0.0.11",
    "@alphacifer/tsconfig": "^0.0.16",
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@vitest/coverage-istanbul": "5.0.2",
    "changeset": "0.2.6",
    "lefthook": "2.1.14",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "tslib": "2.8.1"
  }
}
